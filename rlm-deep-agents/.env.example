# Copy to .env and fill in the values for the provider you want to use.
#
# The orchestrator model. Uses LangChain's "provider:model" identifier format.
# Both the orchestrator and every subagent it dispatches run on this model
# unless a subagent overrides it with its own "model" field.
RLM_MODEL=anthropic:claude-sonnet-5

# --- Provide the key that matches RLM_MODEL's provider ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Optional: send traces to LangSmith to watch subagents spawn live.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
